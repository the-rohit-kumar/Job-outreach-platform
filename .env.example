# ---------------------------------------------------------------------------
# OutreachHub .env  ->  copy to .env and edit. Never commit .env.
# ---------------------------------------------------------------------------

# Signing key for the login session cookie. Any long random string.
# Generate one: python -c "import secrets;print(secrets.token_urlsafe(48))"
APP_SECRET=change-me-to-a-long-random-string

# SQLite by default. Postgres-ready, e.g.:
# DATABASE_URL=postgresql+psycopg://outreach:outreach@localhost:5432/outreach
DATABASE_URL=sqlite:///./data/outreach.db

# Where the web app runs (used for CORS + the Chrome extension target).
APP_URL=http://localhost:3000
API_URL=http://localhost:8000

# LLM provider (used from step 4 onward). Anthropic is the default provider.
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Cheap model for filtering/scoring, stronger model for drafting.
LLM_FAST_MODEL=claude-haiku-4-5-20251001
LLM_STRONG_MODEL=claude-sonnet-4-5-20250929
# Daily spend cap in USD. The app refuses to call the LLM past this.
LLM_DAILY_SPEND_CAP_USD=5.00

# Search API used by the search-dork collector (step 8).
SEARCH_PROVIDER=brave
BRAVE_API_KEY=
SERPAPI_KEY=

# Reddit official API (step 8).
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Gmail OAuth (step 5). Create credentials in Google Cloud Console,
# type "Desktop app", paste the client id/secret here. No passwords ever.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/gmail/oauth/callback
